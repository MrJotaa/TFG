diff --git a/frontend/src/components/evaluation/EvaluationTabs.jsx b/frontend/src/components/evaluation/EvaluationTabs.jsx
index ac69344..e8891aa 100644
--- a/frontend/src/components/evaluation/EvaluationTabs.jsx
+++ b/frontend/src/components/evaluation/EvaluationTabs.jsx
@@ -1,21 +1,69 @@
+import { useRef } from 'react'
+
 function EvaluationTabs({ tabs, activeTab, onChange }) {
+    const tabRefs = useRef([])
+
+    function selectTab(index) {
+        const tab = tabs[index]
+
+        if (!tab) {
+            return
+        }
+
+        onChange(tab.id)
+        tabRefs.current[index]?.focus()
+    }
+
+    function handleKeyDown(event, index) {
+        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
+            return
+        }
+
+        event.preventDefault()
+
+        if (event.key === 'Home') {
+            selectTab(0)
+            return
+        }
+
+        if (event.key === 'End') {
+            selectTab(tabs.length - 1)
+            return
+        }
+
+        const direction = event.key === 'ArrowRight' ? 1 : -1
+        const nextIndex = (index + direction + tabs.length) % tabs.length
+        selectTab(nextIndex)
+    }
+
     return (
         <div className="evaluation-tabs" role="tablist" aria-label="Secciones de evaluación">
-            {tabs.map((tab) => (
-                <button
-                    key={tab.id}
-                    type="button"
-                    role="tab"
-                    aria-selected={activeTab === tab.id}
-                    className={activeTab === tab.id ? 'evaluation-tab active' : 'evaluation-tab'}
-                    onClick={() => onChange(tab.id)}
-                >
-                    <span>{tab.label}</span>
-                    {tab.badge !== undefined && tab.badge !== null && (
-                        <small>{tab.badge}</small>
-                    )}
-                </button>
-            ))}
+            {tabs.map((tab, index) => {
+                const isActive = activeTab === tab.id
+
+                return (
+                    <button
+                        key={tab.id}
+                        ref={(element) => {
+                            tabRefs.current[index] = element
+                        }}
+                        id={`evaluation-tab-${tab.id}`}
+                        type="button"
+                        role="tab"
+                        aria-controls={`evaluation-panel-${tab.id}`}
+                        aria-selected={isActive}
+                        tabIndex={isActive ? 0 : -1}
+                        className={isActive ? 'evaluation-tab active' : 'evaluation-tab'}
+                        onClick={() => onChange(tab.id)}
+                        onKeyDown={(event) => handleKeyDown(event, index)}
+                    >
+                        <span>{tab.label}</span>
+                        {tab.badge !== undefined && tab.badge !== null && (
+                            <small aria-label={`${tab.badge} elementos`}>{tab.badge}</small>
+                        )}
+                    </button>
+                )
+            })}
         </div>
     )
 }
diff --git a/frontend/src/index.css b/frontend/src/index.css
index 80a5309..d19ba7a 100644
--- a/frontend/src/index.css
+++ b/frontend/src/index.css
@@ -3205,3 +3205,127 @@ button {
         gap: 0.55rem;
     }
 }
+
+/* Classification evaluation: final responsive and accessibility polish */
+.evaluation-sr-only {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+    border: 0;
+}
+
+.evaluation-dashboard button:focus-visible,
+.evaluation-dashboard input:focus-visible,
+.evaluation-dashboard select:focus-visible,
+.evaluation-tab-panel:focus-visible {
+    outline: 3px solid rgba(37, 99, 235, 0.42);
+    outline-offset: 3px;
+}
+
+.evaluation-tabs {
+    scrollbar-width: thin;
+    scroll-snap-type: x proximity;
+    overscroll-behavior-x: contain;
+}
+
+.evaluation-tab {
+    min-height: 44px;
+    scroll-snap-align: start;
+}
+
+.evaluation-tab-panel {
+    outline: none;
+}
+
+.evaluation-tab-panel:focus-visible {
+    border-radius: 0 0 20px 20px;
+}
+
+.evaluation-segmented-control button,
+.evaluation-image-filter-list button,
+.evaluation-detail-button,
+.evaluation-pagination button {
+    min-height: 42px;
+}
+
+.evaluation-image-card,
+.class-metric-card,
+.curve-score-card,
+.evaluation-metric-card {
+    transition:
+        transform 160ms ease,
+        box-shadow 160ms ease,
+        border-color 160ms ease;
+}
+
+.evaluation-image-diagnostics[hidden] {
+    display: none;
+}
+
+@media (hover: hover) and (pointer: fine) {
+    .evaluation-image-card:hover,
+    .class-metric-card:hover,
+    .curve-score-card:hover,
+    .evaluation-metric-card:hover {
+        transform: translateY(-2px);
+        border-color: rgba(37, 99, 235, 0.2);
+        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
+    }
+}
+
+@media (max-width: 560px) {
+    .evaluation-results-shell {
+        border-radius: 16px;
+    }
+
+    .evaluation-tabs {
+        padding: 0.55rem;
+    }
+
+    .evaluation-tab {
+        padding-inline: 0.75rem;
+    }
+
+    .evaluation-tab-panel {
+        min-height: 360px;
+        padding: 0.65rem;
+    }
+
+    .evaluation-run-card.modern,
+    .evaluation-surface,
+    .evaluation-image-card-body {
+        padding: 0.85rem;
+    }
+
+    .evaluation-image-summary dl div {
+        align-items: flex-start;
+        flex-direction: column;
+        gap: 0.2rem;
+    }
+
+    .evaluation-image-summary dd {
+        max-width: 100%;
+        text-align: left;
+        white-space: normal;
+    }
+
+    .evaluation-pagination button {
+        padding-inline: 0.65rem;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .evaluation-dashboard *,
+    .evaluation-dashboard *::before,
+    .evaluation-dashboard *::after {
+        scroll-behavior: auto !important;
+        animation-duration: 0.01ms !important;
+        animation-iteration-count: 1 !important;
+        transition-duration: 0.01ms !important;
+    }
+}
