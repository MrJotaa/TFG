# Clave utilizada para firmar los tokens de autenticación.
# Sustituir por una clave aleatoria para entornos no locales.
JWT_SECRET_KEY=change-me-local-development-secret

# Configuración de MongoDB para ejecución local fuera de Docker.
# Docker Compose sobrescribe MONGO_URL con la dirección del servicio interno.
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=tfg_adversarial_ai

# Rutas de almacenamiento.
UPLOADS_DATASETS_PATH=uploads/datasets
DETECTION_EVALUATIONS_BASE_PATH=uploads/evaluations

# Tamaño máximo permitido para archivos de anotaciones COCO (10 MiB).
COCO_MAX_UPLOAD_BYTES=10485760
